{
  "expo": {
    "name": "Laba4",
    "slug": "Laba4",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.rmd.lab4notifications",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.com.rmd.lab4notifications.onesignal"
        ]
      }
    },
    "android": {
      "package": "com.anonymous.Lab4"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": ["default"]
        }
      ]
    ],
    "extra": {
      "oneSignalAppId": "50c1eec8-f116-40e2-b1ff-c25fdf277b97",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.rmd.lab4notifications.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.rmd.lab4notifications.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.rmd.lab4notifications.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.rmd.lab4notifications.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.rmd.lab4notifications.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.rmd.lab4notifications.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6b6da3be-9c91-4a4c-bbbb-57813e1033fd"
      }
    },
    "owner": "ipz232_boo"
  }
}
